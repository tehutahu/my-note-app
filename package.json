{
  "name": "my-note-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-pdf-assets.mjs && node scripts/build-pwa.mjs",
    "test": "vitest run",
    "check": "eslint . && tsc --noEmit && vitest run --coverage && vite build && node scripts/copy-pdf-assets.mjs && node scripts/build-pwa.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289"
  }
}
